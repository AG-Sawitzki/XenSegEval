#!/bin/bash
#
#SBATCH --job-name=eval
#SBATCH --wait#SBATCH --gres=
#SBATCH --time=1-00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=12
#SBATCH --output=/data/cephfs-2/unmirrored/groups/sawitzki/Juno/TMA2/run/processing/eval/logs/%N_%j.out
#SBATCH --error=/data/cephfs-2/unmirrored/groups/sawitzki/Juno/TMA2/run/processing/eval/logs/%N_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL,TIME_LIMIT_90,TIME_LIMIT_80,TIME_LIMIT_50
#SBATCH --mail-user=julius.normann@bih-charite.de
#
. ~/.bashrc
micromamba activate simple
#
python eval/eval.py -c config.toml -m ucs
ect

